{
  "name": "@mediatech/kiosk-protocol",
  "version": "0.2.0",
  "description": "Contrat WebSocket de pilotage d'une borne ScriptEurist : événements, consignes, état.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "kiosk",
    "websocket",
    "protocol",
    "scripteurist"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaume-scripteurist/kiosk-protocol.git"
  }
}
